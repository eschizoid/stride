{
  "title": "compare",
  "description": "Payload of `stride compare week`.",
  "type": "object",
  "required": [
    "current",
    "period",
    "prior",
    "window_label"
  ],
  "additionalKeys": false,
  "properties": {
    "current": {
      "type": "object",
      "required": [
        "ctl",
        "easy_pct",
        "hard_min",
        "has_data",
        "polarization_known",
        "sessions",
        "tss"
      ],
      "additionalKeys": false,
      "properties": {
        "ctl": {
          "type": "number"
        },
        "easy_pct": {
          "type": "number"
        },
        "hard_min": {
          "type": "integer"
        },
        "has_data": {
          "type": "boolean"
        },
        "sessions": {
          "type": "integer"
        },
        "tss": {
          "type": "number"
        },
        "polarization_known": {
          "type": "boolean",
          "description": "true when the window holds any zone seconds; hard_min and easy_pct are measurements only then - an all-zero zone vector cannot distinguish no-zone-data from unzonable sessions"
