{
  "title": "viz",
  "description": "Payload of `stride viz` — the window's self-published bus capabilities, and what it is looking at now.",
  "type": "object",
  "required": [
    "fields",
    "focus",
    "focus_staleness_seconds",
    "history",
    "protocol",
    "published_at",
    "staleness_seconds",
    "views",
    "captures"
  ],
  "additionalKeys": false,
  "properties": {
    "protocol": {
      "type": "integer"
    },
    "published_at": {
      "type": "string"
    },
    "staleness_seconds": {
      "type": "integer"
    },
    "focus_staleness_seconds": {
      "type": "integer"
    },
    "focus": {
      "description": "The viz_focus row with its age judged for the reader: present says a row exists, live says it is younger than focus_staleness_seconds. A window closed by the OS button or crashed leaves its last row behind; live is what separates that history from what the athlete sees.",
      "type": "object",
      "required": [
        "age_seconds",
        "cursor_day",
        "ghost_day",
        "ghost_id",
        "live",
        "present",
        "range",
        "trace_day",
        "trace_id",
        "updated_at",
        "view"
      ],
      "additionalKeys": false,
      "properties": {
        "present": {
          "type": "boolean"
        },
        "live": {
          "type": "boolean"
        },
        "age_seconds": {
          "type": "integer"
        },
        "updated_at": {
          "type": "string"
        },
        "view": {
          "type": "integer"
        },
        "range": {
          "type": "integer"
        },
        "cursor_day": {
          "type": "string"
        },
        "trace_day": {
          "type": "string"
        },
        "trace_id": {
          "type": "integer"
        },
        "ghost_day": {
          "type": "string"
        },
        "ghost_id": {
          "type": "integer"
        }
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalKeys": false,
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "accepts",
          "kind",
          "name"
        ],
        "additionalKeys": false,
        "properties": {
          "accepts": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "history": {
      "description": "The last ten directives, newest first, each with the status and error the lifecycle recorded, so an agent verifies an outcome here rather than by parsing the table. Empty while no directive has been written. A -1 in trace_id or ghost_id means the directive did not name that session, the value could not be read as an integer, or the row predates the id columns; fields decode one by one, so a hostile value in one column never hides the row.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "applied_at",
          "created_at",
          "cursor_day",
          "error",
          "ghost_day",
          "ghost_id",
          "id",
          "range",
          "status",
          "trace_day",
          "trace_id",
          "view",
          "capture",
          "result"
        ],
        "additionalKeys": false,
        "properties": {
          "id": {
            "type": "integer"
          },
          "created_at": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "applied_at": {
            "type": "string"
          },
          "view": {
            "type": "integer"
          },
          "range": {
            "type": "integer"
          },
          "cursor_day": {
            "type": "string"
          },
          "trace_day": {
            "type": "string"
          },
          "trace_id": {
            "type": "integer"
          },
          "ghost_day": {
            "type": "string"
          },
          "ghost_id": {
            "type": "integer"
          },
          "capture": {
            "type": "string",
            "description": "what the directive asked the window to capture: png, webm_start, webm_stop, or empty"
          },
          "result": {
            "type": "string",
            "description": "the file a capture produced, under ./captures beside the database, or empty"
          }
        }
      }
    },
    "captures": {
      "type": "array",
      "description": "the last ten directives that asked for a capture, newest first, each with its status, error and result; empty while none has",
      "items": {
        "type": "object",
        "required": [
          "applied_at",
          "created_at",
          "cursor_day",
          "error",
          "ghost_day",
          "ghost_id",
          "id",
