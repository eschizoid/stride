      "type": "integer"
    },
    "published_at": {
      "type": "string"
    },
    "staleness_seconds": {
      "type": "integer"
    },
    "focus_staleness_seconds": {
      "type": "integer"
    },
    "focus": {
      "description": "The viz_focus row with its age judged for the reader: present says a row exists, live says it is younger than focus_staleness_seconds. A window closed by the OS button or crashed leaves its last row behind; live is what separates that history from what the athlete sees.",
      "type": "object",
      "required": [
        "age_seconds",
        "cursor_day",
        "ghost_day",
        "ghost_id",
        "live",
        "present",
        "range",
        "trace_day",
        "trace_id",
        "updated_at",
        "view"
      ],
      "additionalKeys": false,
      "properties": {
        "present": {
          "type": "boolean"
        },
        "live": {
          "type": "boolean"
        },
        "age_seconds": {
          "type": "integer"
        },
        "updated_at": {
          "type": "string"
        },
        "view": {
          "type": "integer"
        },
        "range": {
          "type": "integer"
        },
        "cursor_day": {
          "type": "string"
        },
        "trace_day": {
          "type": "string"
        },
        "trace_id": {
          "type": "integer"
        },
        "ghost_day": {
          "type": "string"
        },
        "ghost_id": {
          "type": "integer"
        }
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalKeys": false,
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "accepts",
          "kind",
          "name"
        ],
        "additionalKeys": false,
        "properties": {
          "accepts": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "history": {
      "description": "The last ten directives, newest first, each with the status and error the lifecycle recorded, so an agent verifies an outcome here rather than by parsing the table. Empty when the window has never created the table. Rows written by a window from before the id columns report trace_id and ghost_id as -1.",
