/stride
.DS_Store
.idea/
.claude/PLAN.md

# test binary (built on demand from tests/e2e.roc)
/e2e

# e2e fixture-write failure log (#226): truncated at the start of every run and removed
# on a clean finish, so it is only ever present after a run that aborted
/.e2e-sqlfail
/.e2e-sqlfail.err
# per-check tally, so a driver can assert it ran the checks it contains (#232);
# scoped per process and removed by the guard that reads it (#266); a run that FAILS before
# its guard still leaves one, which is why the glob stays broad
/.e2e-checks*

# scratch build binaries from build/debug cycles (only /stride is kept)
/stride-*

# token-savior index cache (local tool artifact)
.token-savior-cache.json

# local Strava account exports contain private activity data
/export_*.zip

# patch(1) leaves these behind, and a `git add -A` once committed a 591 KB stale copy of
# the whole e2e suite — a SECOND, disagreeing test file with its own check tally, which a
# grep for any check name returns alongside the real one.
*.orig
*.rej
